# Generated/downloaded data — never commit (regenerate by running the pipeline).
# Ignore the CONTENTS of data/ (not the dir itself) so the exception below works:
# you cannot un-ignore a file inside a fully-ignored directory.
data/*
*.db
*.csv

# ...EXCEPT the minimal compressed index the public web app ships with,
# and the parsed third-party PRE/ESC analysis used for prioritisation.
!data/public_index.csv.gz
!data/official/
!data/official/official_by_mesa.csv.gz
# but NOT the throwaway SQL batches used to bulk-load official_data once.
data/official/batches/

# Secrets / session
.env
.env.local
cookies.txt
*.cookies

# Bundled third-party model data (user downloads it; see INSTALL_OCR.md)
**/tessdata/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# Playwright / browser
.playwright-mcp/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
