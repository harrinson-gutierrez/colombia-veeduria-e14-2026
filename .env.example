# Copy this file to .env and fill in your values. .env is gitignored.
# The review/public servers read these to enable login + consensus.

# Your Supabase project URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# PUBLISHABLE key (safe in the browser; RLS limits it to inserting your own
# reports and reading the public consensus). NOT the service_role key.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SERVICE ROLE key — ADMIN, keep secret. ONLY used locally by load_official.py
# to bulk-load the official PRE/ESC data. Never ship this in the app/.exe.
# SUPABASE_SERVICE_KEY=eyJ...
